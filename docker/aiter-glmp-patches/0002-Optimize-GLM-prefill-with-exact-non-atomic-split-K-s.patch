+# SPDX-License-Identifier: MIT
+"""GLM stage1: existing CK arithmetic, two disjoint SET planes, exact FP32 sum.
+
+This candidate retains M32/N128/K128, 256 threads, waves1x4, V1/Intrawave,
+16x16x32 FP8 MFMA, the original two K2048 partitions, scales, canonical output
+scatter and the existing SplitOp element conversion. Only the final partial
+memory operation changes AtomicAdd -> Set with plane=blockIdx.z. The sum uses
+two explicit v_add_f32 instructions in +0,p0,p1 order, not reassociable C++.
+
+There is deliberately no activation/quantization/GEMM2 coupling. Both live
+workspace planes are zeroed before SET, so masked route slots have defined +0
+partials. Sum reads/writes only tokens*9 rows; padded raw/workspace rows are
+never read. Workspace is [2,original_M32_sorted_capacity,2048] FP32, or twice
+the original raw buffer size extra memory. No allocation occurs in launch.
+
+Source detail that must NOT change: existing
+MulABScaleExpertWeightA8W8blkscaleSplitk<float,float,float> in the CK host header
+currently converts c through F16 before assigning e (FP32). This candidate
+reuses that exact type. FP32 describes the stored raw buffer, not a license to
+replace that element operation with PassThrough.
+
+No numerical/performance acceptance is implied. Strict raw-bit/activation/
+quant probes, baseline repeats, masked replay and actual-device profiling are
+required. Default model dispatch remains disabled/owned by the parent.
+"""
+
+import torch
+from torch import Tensor
+
+from aiter.jit.core import AITER_CSRC_DIR, compile_ops
+
+KERNEL_NAME = "glm_moe_stage1_partials_set_m32n128k128_split2"
+DEVICE_SET_SYMBOL = "kernel_glm_moe_stage1_partials_set"
+DEVICE_SUM_SYMBOL = "kernel_glm_moe_stage1_sum_exact"
+
+
+def _build_args(*args, **kwargs):
+    # Inherit the same CK compiler flags/include setup as the existing stage1,
+    # but compile only this fixed instance and its own pybind, not the generator.
+    return {
+        "md_name": "module_glm_prefill_stage1_partials_v1",
+        "srcs": [f"{AITER_CSRC_DIR}/glm_prefill_stage1_partials.cu"],
+        "blob_gen_cmd": "",
+    }
+
+
+@compile_ops(
+    "module_moe_ck2stages", fc_name="glm_prefill_stage1_partials", gen_func=_build_args
+)
+def write_partials(
+    a1: Tensor,
+    w1: Tensor,
+    ids: Tensor,
+    expert_ids: Tensor,
+    valid: Tensor,
+    w1_scale: Tensor,
+    a1_scale: Tensor,
+    workspace: Tensor,
+) -> None: ...
+
+
+@compile_ops(
+    "module_moe_ck2stages", fc_name="glm_prefill_stage1_sum", gen_func=_build_args
+)
+def combine(workspace: Tensor, out: Tensor, tokens: int) -> None: ...
+
+
+def allocate_workspace(out: Tensor) -> Tensor:
+    """Allocate once outside capture; out is the original FP32 raw GU buffer."""
+    if (
+        out.ndim != 2
+        or out.shape[1] != 2048
+        or out.dtype != torch.float32
+        or not out.is_cuda
+        or not out.is_contiguous()
+    ):
+        raise ValueError(
+            "requires contiguous GPU FP32 raw [sorted_capacity,2048] output"
+        )
+    return torch.empty((2, *out.shape), device=out.device, dtype=out.dtype)
+
+
+def unsupported_reason(
+    a1,
+    w1,
+    w2,
+    ids,
+    expert_ids,
+    valid,
+    out,
+    topk,
+    w1_scale,
+    a1_scale,
+    *,
+    workspace,
+    is_shuffled=False,
+):
+    tensors = (a1, w1, w2, ids, expert_ids, valid, out, w1_scale, a1_scale)
+    if any(not isinstance(t, Tensor) for t in tensors):
+        return "all stage1 tensors and FP32 scales are required"
+    if a1.ndim != 2 or not 256 <= a1.shape[0] <= 32768 or a1.shape[1] != 4096:
+        return "requires 256..32768 tokens and hidden4096"
+    m = a1.shape[0]
+    if tuple(w1.shape) != (289, 2048, 4096) or tuple(w2.shape) != (289, 4096, 1024):
+        return "requires 289 experts and TP2 intermediate1024 separated GU"
+    if topk != 9 or not is_shuffled:
+        return "requires top9 and separated tile-preshuffled GU"
+    if any(t.dtype != torch.float8_e4m3fnuz for t in (a1, w1, w2)):
+        return "requires FNUZ FP8 A/W"
+    if w1_scale.dtype != torch.float32 or a1_scale.dtype != torch.float32:
+        return "requires FP32 block scales"
+    if tuple(w1_scale.shape) != (289, 16, 32) or tuple(a1_scale.shape) != (m, 32):
+        return "requires contiguous A1x128 and W128x128 scales"
+    if any(t.ndim != 1 or t.dtype != torch.int32 for t in (ids, expert_ids, valid)):
+        return "requires int32 vector sorting metadata"
+    rows = m * 9 + 289 * 32 - 9
+    if (
+        ids.numel() != rows
+        or expert_ids.numel() < (rows + 31) // 32
+        or valid.numel() != 2
+    ):
+        return "requires original M32 sorting capacity"
+    if tuple(out.shape) != (rows, 2048) or out.dtype != torch.float32:
+        return "requires raw FP32 output with original sorted capacity"
+    if not a1.is_cuda or any(
+        t.device != a1.device or not t.is_contiguous() for t in tensors
+    ):
+        return "requires contiguous tensors on one GPU"
+    if any(t.data_ptr() % 16 for t in tensors):
+        return "requires 16-byte aligned tensor bases"
+    if (
+        torch.cuda.get_device_properties(a1.device).gcnArchName.split(":", 1)[0]
+        != "gfx942"
+    ):
+        return "requires gfx942"
+    if (
+        not isinstance(workspace, Tensor)
+        or workspace.dtype != torch.float32
+        or tuple(workspace.shape) != (2, *out.shape)
+        or workspace.device != out.device
+        or not workspace.is_contiguous()
+        or workspace.data_ptr() % 16
+    ):
+        return "requires disjoint contiguous FP32 workspace[2,sorted_capacity,2048]"
+    wb, we = workspace.data_ptr(), workspace.data_ptr() + workspace.numel() * 4
+    for t in (a1, w1, w2, ids, expert_ids, valid, out, w1_scale, a1_scale):
+        tb, te = t.data_ptr(), t.data_ptr() + t.numel() * t.element_size()
+        if wb < te and tb < we:
+            return "partial workspace must not overlap any stage1 input/output"
+    return None
+
+
+def select_kernel(*args, enabled=False, **kwargs):
+    if not enabled or unsupported_reason(*args, **kwargs) is not None:
+        return None
+    return KERNEL_NAME
+
+
+def launch(
+    a1,
+    w1,
+    w2,
+    ids,
+    expert_ids,
+    valid,
+    out,
+    topk,
+    w1_scale,
+    a1_scale,
+    *,
+    workspace,
+    is_shuffled=False,
+):
+    """Initialize live partials, run unchanged CK with SET, then exact FP32 sum.
+
+    Workspace must not alias any input/output. First launch builds native code;
+    warm before capture. Original sorted metadata and output padding are intact.
+    """
+    reason = unsupported_reason(
+        a1,
+        w1,
+        w2,
+        ids,
+        expert_ids,
+        valid,
+        out,
+        topk,
+        w1_scale,
+        a1_scale,
+        workspace=workspace,
+        is_shuffled=is_shuffled,
+    )
+    if reason is not None:
+        raise NotImplementedError(reason)
+    write_partials(a1, w1, ids, expert_ids, valid, w1_scale, a1_scale, workspace)
+    combine(workspace, out, a1.shape[0])
